# Prefer `keelson init`: it writes ~/.keelson/config.env, which every project uses.
# This file is still read from the current folder only (not parent folders).

# ── Generic config (DeepSeek; a base URL containing /anthropic uses the Anthropic protocol) ──
APIKEY=sk-your-api-key
API=https://api.deepseek.com
MODEL=deepseek-flash
# deepseek-chat and deepseek-reasoner were retired on 2026-07-24.

# Optional generic aliases
# KEELSON_API_KEY=sk-your-api-key
# KEELSON_API_BASE=https://api.deepseek.com

# ── Limits (optional; Keelson knows common models) ──
# KEELSON_CONTEXT_WINDOW=256000          # tokens Keelson plans against before folding
# KEELSON_MAX_OUTPUT_TOKENS=65536        # max_tokens per request

# ── Anthropic native ──
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL=claude-sonnet-4-5

# ── OpenAI-compatible ──
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://your-openai-compatible-host/v1
# MODEL=gpt-4o

# ── Self-evolving Skills (all optional; shown with defaults) ──
# KEELSON_AUTO_SKILL_EVOLUTION=1        # background skill distillation after each turn
# KEELSON_AUTO_SKILL_TARGET=project     # project | user
# KEELSON_HOME=~/.keelson                # runtime state root (sessions, skills, memory)
