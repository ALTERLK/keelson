# Normalize line endings — keep LF in the repo on every platform.
* text=auto eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.png   binary
*.gif   binary
*.woff2 binary
*.pdf   binary
*.jpg   binary
*.sh    text eol=lf
*.ps1   text eol=lf
*.bat   text eol=crlf
*.css   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.jsonl text eol=lf
