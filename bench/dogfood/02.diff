+def _indent(line: str) -> int:
+    return len(line.expandtabs(4)) - len(line.expandtabs(4).lstrip())
+
+
+_JS_TEST = re.compile(r"^\s*(it|test|describe)(?:\.\w+)?\s*\(\s*(['\"`])([^'\"`]*)\2")
+_JS_DEF = re.compile(r"^\s*(?:async\s+)?(?:function|class)\b|^\s*(?:const|let|var)\s+\w+\s*=")
+_PY_DEF = re.compile(r"^\s*(?:async\s+)?(?:def|class)\b")
+_MODULE = "<module>"                                  # not an f-string: f"{_MODULE}" would print the name
+
+
+def _sig(header: str, js: bool) -> str:
+    """A stable name for the block a header line opens: a test's name, or the def/class/describe."""
+    m = _JS_TEST.match(header) if js else None
+    return f"{m.group(1)}({m.group(2)}{m.group(3)}{m.group(2)}" if m else header.strip().rstrip(":{")
+
+
+def _block_above(lines: list[str], lineno: int, js: bool) -> list[str] | None:
+    """Signature chain (outermost first) of the block holding ``lines[lineno]``; empty at top level."""
+    level = _indent(lines[lineno])
+    chain: list[str] = []
+    for j in range(lineno - 1, -1, -1):
+        line = lines[j]
+        if not line.strip() or _indent(line) >= level:
+            continue                                # blank, or deeper: inside the same block
+        opener = (_JS_TEST.match(line) if js else _TEST_DEF.match(line)) or \
+                 (_JS_DEF.match(line) if js else _PY_DEF.match(line))
+        if opener:
+            chain.insert(0, _sig(line, js))
+        level = _indent(line)
+        if level == 0:
+            break
+    return chain
+
+
+def _marker_line(lines: list[str], lineno: int) -> int:
+    """The header a marker at ``lineno`` applies to: itself, or the definition under its decorators."""
+    if not lines[lineno].strip().startswith("@"):
+        return lineno
+    for i in range(lineno + 1, len(lines)):
+        stripped = lines[i].strip()
+        if stripped and not stripped.startswith(("@", "#")):
+            return i
+    return lineno
+
+
+def _skipped_tests(text: str, js: bool) -> list[tuple[str, str]]:
+    """(signature of the skipped test, "whole" | "part") for every marker that skips an existing test.
+
+    "whole": a decorator, ``it.skip(``, or a skip in a test's body (the test stops running when hit);
+    a skip in a helper or a new test only has itself to skip, so it is not listed.
+    """
+    lines = text.splitlines()
+    found = []
+    for lineno, line in enumerate(lines):
+        for m in _SKIP.finditer(line):
+            before = line[:m.start()]
+            assignment = re.fullmatch(r"\s*\w+\s*=\s*", before) is not None   # `pytestmark = pytest.mark.skip`
+            starts_marker = before.lstrip().startswith("@") or assignment or \
+                (js and (_JS_TEST.search(before + line[m.start():]) is not None or
+                         re.fullmatch(r"\s*(?:it|test|describe)", before) is not None))
+            if before.strip() and not starts_marker:
+                continue                            # after code on the line: `x = pytest.skip(...)`
+            header = _marker_line(lines, lineno)
+            chain = _block_above(lines, header, js)
+            if not chain:
+                found.append((_MODULE, "whole"))    # top level: pytestmark, a decorator on a class
+                continue
+            is_test = bool(_JS_TEST.match(lines[header]) if js else _TEST_DEF.match(lines[header]))
+            found.append((" / ".join(chain), "whole" if is_test or not js else "part"))
+            if not js and not is_test and _indent(lines[header]) == 0:
+                found[-1] = (_MODULE, "whole")      # a decorator on a top-level class
+    return found
+
+
+def _tests_in(text: str, js: bool) -> set[str]:
+    """Signatures of the tests a file defines (a test name, with its describe/class chain)."""
+    lines = text.splitlines()
+    return {_sig(line, js) for line in lines if _JS_TEST.match(line) if js} | \
+        {_sig(line, js) for line in lines if _TEST_DEF.match(line) and not js}
+
+
+def _skips_on_existing_tests(path: str, old: str, new: str) -> int:
+    """Skip markers the change adds where they make tests that already ran stop running.
+
+    A skip in a brand-new test or helper only skips new code, so it does not weaken the file. A
+    module-level skip, a decorator on a test that was already there, and a skip inside such a test
+    do.
+    """
+    js = bool(re.search(r"\.(test|spec)\.[cm]?[jt]sx?$", path.replace("\\", "/"), re.IGNORECASE))
+    before, after = _skipped_tests(old, js), _skipped_tests(new, js)
+    old_tests = _tests_in(old, js)
+    added = after.count((_MODULE, "whole")) - before.count((_MODULE, "whole"))
+    for key in {key for key, _kind in after} - {_MODULE}:
+        if not any(k == key or k.startswith(key) for k in old_tests):
+            continue                                # a new test (or describe/class): nothing was skipped
+        n_before = before.count((key, "whole")) + before.count((key, "part"))
+        n_after = after.count((key, "whole")) + after.count((key, "part"))
+        added += n_after - n_before
+    return max(0, added)
+
+
